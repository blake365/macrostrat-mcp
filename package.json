{
	"name": "macrostrat-mcp",
	"version": "1.0.0",
	"description": "Macrostrat MCP Server - Access geological data, rock units, formations, and stratigraphic information worldwide",
	"type": "module",
	"main": "./build/server.js",
	"types": "./build/server.d.ts",
	"exports": {
		".": {
			"types": "./build/server.d.ts",
			"default": "./build/server.js"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"macrostrat-mcp": "build/index.js"
	},
	"scripts": {
		"build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
		"dev": "tsx src/index.ts",
		"start": "node build/index.js",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"files": [
		"build",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"macrostrat",
		"geology",
		"stratigraphy",
		"mcp",
		"modelcontextprotocol",
		"model-context-protocol",
		"mcp-server",
		"claude",
		"geoscience",
		"bedrock",
		"minerals"
	],
	"author": "Blake Morgan",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/blake365/macrostrat-mcp.git"
	},
	"homepage": "https://github.com/blake365/macrostrat-mcp#readme",
	"bugs": {
		"url": "https://github.com/blake365/macrostrat-mcp/issues"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"tsx": "^4.23.11",
		"typescript": "^5.9.3"
	}
}
